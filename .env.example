EDA_URL=https://your-eda-instance.com
EDA_USERNAME=admin
EDA_PASSWORD=admin

# Optional: if empty, the launcher will fetch it via Keycloak credentials below
EDA_CLIENT_SECRET=

# Optional: defaults to EDA_USERNAME/EDA_PASSWORD
EDA_KC_USERNAME=admin
EDA_KC_PASSWORD=admin

# Behavior switches
EDA_CONNECT=true
EDA_AUTO_LOGIN=true
EDA_DIRECT_LOGIN_FALLBACK=true
EDA_HEADLESS=false
EDA_RESET_PROFILE=true
EDA_KEEP_OPEN=true

# Optional overrides
# EDA_OPEN_URL=https://your-eda-instance.com
# EDA_PROFILE_DIR=/tmp/eda-browser-extension-profile
# EDA_ENV_FILE=.env
